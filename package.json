{
  "name": "sommhai",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "check-types": "turbo run check-types",
    "ui:add": "pnpm --filter @sommhai/ui ui:add",
    "db:seed:local": "pnpm --filter api seed:local",
    "db:seed:neon": "pnpm --filter api seed:neon",
    "db:reset:local": "pnpm --filter api reset:local",
    "db:reset:neon": "pnpm --filter api reset:neon",
    "db:generate:local": "pnpm --filter api generate:local",
    "db:generate:neon": "pnpm --filter api generate:neon",
    "db:migrate:local": "pnpm --filter api migrate:local",
    "db:migrate:neon": "pnpm --filter api migrate:neon",
    "db:migrate:all": "pnpm --filter api migrate:all",
    "db:push:local": "pnpm --filter api push:local",
    "db:push:neon": "pnpm --filter api push:neon",
    "db:studio:local": "pnpm --filter api studio:local",
    "db:studio:neon": "pnpm --filter api studio:neon"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@sommhai/eslint-config": "workspace:*",
    "@sommhai/tailwind-config": "workspace:*",
    "@sommhai/typescript-config": "workspace:*",
    "eslint": "^9.23.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.4.4"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "next": "^15.1.6",
      "prisma": "^6.5.0",
      "@prisma/client": "^6.5.0"
    }
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
