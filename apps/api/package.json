{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "ts-node build.ts",
    "dev": "tsnd --files --watch .env --respawn src/index.ts",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf build",
    "check-types": "tsc --noEmit",
    "seed:local": "dotenv -e .env prisma db seed",
    "seed:neon": "dotenv -e .env.dev prisma db seed",
    "reset:local": "dotenv -e .env prisma migrate reset --force",
    "reset:neon": "dotenv -e .env.dev prisma migrate reset --force",
    "generate:local": "dotenv -e .env prisma generate",
    "generate:neon": "dotenv -e .env.dev prisma generate",
    "migrate:local": "dotenv -e .env prisma migrate dev",
    "migrate:neon": "dotenv -e .env.dev prisma migrate dev",
    "migrate:all": "dotenv -e .env prisma migrate dev && dotenv -e .env.dev prisma migrate dev",
    "push:local": "dotenv -e .env prisma db push",
    "push:neon": "dotenv -e .env.dev prisma db push",
    "studio:local": "dotenv -e .env prisma studio",
    "studio:neon": "dotenv -e .env.dev prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.5.0",
    "@prisma/client": "6.5.0",
    "@sommhai/api-contract": "workspace:*",
    "@sommhai/eslint-config": "workspace:*",
    "@sommhai/shared-type": "workspace:*",
    "@sommhai/typescript-config": "workspace:*",
    "@ts-rest/core": "^3.51.0",
    "@ts-rest/express": "^3.51.0",
    "@ts-rest/open-api": "^3.51.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "faker": "^6.6.6",
    "prisma": "^6.5.0",
    "swagger-ui-express": "^5.0.1",
    "ts-error": "^1.0.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/ws": "^8.18.0",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.24.2",
    "esbuild-plugin-copy": "^2.1.1",
    "prisma": "^6.5.0",
    "typescript": "^5.7.3"
  }
}
